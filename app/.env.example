PORT=4100
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-value
DB_PATH=./data/laurelshield.db

# Ed25519 signing keypair for assurance claims and passports. Do not set this
# by hand -- run `node scripts/generate-signing-key.js`, which writes it
# directly into .env (never prints it) and shows you the public key.
PASSPORT_SIGNING_PRIVATE_KEY_B64=

# Shared secret the marketing site's Stripe webhook presents (as the
# x-provision-secret header) when calling POST /internal/provision-org.
# Generate any long random value; must match PROVISION_WEBHOOK_SECRET in the
# marketing site's own .env.
PROVISION_WEBHOOK_SECRET=change-this-to-a-long-random-value
